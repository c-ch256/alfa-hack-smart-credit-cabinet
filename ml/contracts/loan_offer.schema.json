{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Internal LoanOffer v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "application_id",
    "product_code",
    "amount",
    "term_months",
    "annual_rate",
    "monthly_payment",
    "dscr",
    "rank_score"
  ],
  "properties": {
    "product_code": {
      "enum": [
        "working_capital",
        "investment"
      ]
    },
    "amount": {
      "type": "integer",
      "minimum": 1
    },
    "term_months": {
      "type": "integer",
      "minimum": 1
    },
    "annual_rate": {
      "type": "number",
      "minimum": 0
    },
    "monthly_payment": {
      "type": "number",
      "minimum": 0
    },
    "application_id": {
      "type": "string",
      "minLength": 1
    },
    "dscr": {
      "type": "number"
    },
    "rank_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
